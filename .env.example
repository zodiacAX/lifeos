APP_NAME=LIFE//OS
# Local development can omit DATABASE_URL and use ./data/lifeos.db.
# Vercel production MUST use a persistent Postgres URL from Neon/Supabase/etc.
DATABASE_URL=
# Legacy Vercel/Neon integrations may expose POSTGRES_URL instead; the app supports both.
POSTGRES_URL=
JWT_SECRET=replace-with-a-long-random-secret-before-production
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:3000
